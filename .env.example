# Copy this file to .env and adjust as needed. Never commit real keys.
# Real environment variables override values in this file.

# ---- Backend ---------------------------------------------------------------
ENVIRONMENT=development
# Relative SQLite paths are resolved against backend/.
DATABASE_URL=sqlite:///./carbon_copy.db
# Origin allowed by CORS (http://localhost:5173 and http://127.0.0.1:5173 are always allowed).
FRONTEND_URL=http://localhost:5173
SQL_ECHO=false

# ---- AI layer --------------------------------------------------------------
# Reserved for the future Claude integration. Not used yet; leave empty.
CLAUDE_API_KEY=

# ---- Frontend (read by Vite; must start with VITE_) -----------------------
VITE_API_BASE_URL=http://localhost:8000

# Learning recommendations stay advisory; true adds bounded adjustment proposals (not applied).
LEARNING_ADJUSTMENTS_ENABLED=false

# ---- Messaging (Phase 10E.1) ----------------------------------------------
# DEMO (default): notifications are only recorded as SIMULATED; nothing is sent.
# LIVE: enables ONE controlled test SMS through Twilio to a registered, consenting test recipient.
# Put the real values only in backend/.env (git-ignored). Never commit credentials and never expose them to the frontend.
MESSAGING_MODE=DEMO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio sender number in E.164 format, e.g. +15551230000
TWILIO_FROM_NUMBER=
# Optional https URL for future delivery-status callbacks (not implemented yet; leave empty).
TWILIO_STATUS_CALLBACK_URL=
